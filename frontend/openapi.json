{
  "components": {
    "schemas": {
      "DecisionRequest": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "enum": [
              "APPROVE",
              "RETURN",
              "ESCALATE"
            ],
            "title": "Action",
            "type": "string"
          },
          "proposal_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Proposal Id"
          },
          "rationale": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Rationale",
            "type": "string"
          },
          "reason_code": {
            "pattern": "^[A-Z][A-Z0-9_]{1,63}$",
            "title": "Reason Code",
            "type": "string"
          }
        },
        "required": [
          "action",
          "rationale",
          "reason_code"
        ],
        "title": "DecisionRequest",
        "type": "object"
      },
      "DecisionResponse": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "enum": [
              "APPROVE",
              "RETURN",
              "ESCALATE"
            ],
            "title": "Action",
            "type": "string"
          },
          "actor_id": {
            "title": "Actor Id",
            "type": "string"
          },
          "decision_id": {
            "format": "uuid",
            "title": "Decision Id",
            "type": "string"
          },
          "exception_id": {
            "format": "uuid",
            "title": "Exception Id",
            "type": "string"
          },
          "invoice_id": {
            "format": "uuid",
            "title": "Invoice Id",
            "type": "string"
          },
          "proposal_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Proposal Id"
          },
          "run_id": {
            "format": "uuid",
            "title": "Run Id",
            "type": "string"
          },
          "stage": {
            "enum": [
              "PENDING_SIGNOFF",
              "QUEUED_FOR_RESUME"
            ],
            "title": "Stage",
            "type": "string"
          }
        },
        "required": [
          "decision_id",
          "exception_id",
          "run_id",
          "invoice_id",
          "action",
          "actor_id",
          "stage",
          "proposal_id"
        ],
        "title": "DecisionResponse",
        "type": "object"
      },
      "DependencyStatuses": {
        "additionalProperties": false,
        "properties": {
          "minio": {
            "enum": [
              "ok",
              "unavailable",
              "timeout",
              "unconfigured"
            ],
            "title": "Minio",
            "type": "string"
          },
          "postgres": {
            "enum": [
              "ok",
              "unavailable",
              "timeout",
              "unconfigured"
            ],
            "title": "Postgres",
            "type": "string"
          }
        },
        "required": [
          "postgres",
          "minio"
        ],
        "title": "DependencyStatuses",
        "type": "object"
      },
      "InvoiceDetail": {
        "additionalProperties": false,
        "properties": {
          "evidence": {
            "additionalProperties": {
              "additionalProperties": {
                "$ref": "#/components/schemas/JsonValue"
              },
              "type": "object"
            },
            "title": "Evidence",
            "type": "object"
          },
          "exception": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/InvoiceException"
              },
              {
                "type": "null"
              }
            ]
          },
          "invoice": {
            "$ref": "#/components/schemas/InvoiceSummary"
          },
          "read_at": {
            "format": "date-time",
            "title": "Read At",
            "type": "string"
          }
        },
        "required": [
          "invoice",
          "exception",
          "evidence",
          "read_at"
        ],
        "title": "InvoiceDetail",
        "type": "object"
      },
      "InvoiceException": {
        "additionalProperties": false,
        "properties": {
          "assigned_to": {
            "anyOf": [
              {
                "maxLength": 128,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Assigned To"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "evidence": {
            "additionalProperties": {
              "$ref": "#/components/schemas/JsonValue"
            },
            "title": "Evidence",
            "type": "object"
          },
          "exception_type": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Exception Type",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "priority": {
            "maximum": 3.0,
            "minimum": 0.0,
            "title": "Priority",
            "type": "integer"
          },
          "recommendation": {
            "additionalProperties": {
              "$ref": "#/components/schemas/JsonValue"
            },
            "title": "Recommendation",
            "type": "object"
          },
          "sla_due_at": {
            "format": "date-time",
            "title": "Sla Due At",
            "type": "string"
          },
          "status": {
            "enum": [
              "OPEN",
              "IN_REVIEW",
              "RESOLVED",
              "ESCALATED"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "id",
          "exception_type",
          "status",
          "priority",
          "sla_due_at",
          "evidence",
          "recommendation",
          "created_at"
        ],
        "title": "InvoiceException",
        "type": "object"
      },
      "InvoicePage": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/InvoiceSummary"
            },
            "maxItems": 100,
            "title": "Items",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "required": [
          "items"
        ],
        "title": "InvoicePage",
        "type": "object"
      },
      "InvoiceSummary": {
        "additionalProperties": false,
        "properties": {
          "content_type": {
            "enum": [
              "application/pdf",
              "image/png",
              "image/jpeg"
            ],
            "title": "Content Type",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "currency": {
            "anyOf": [
              {
                "pattern": "^[A-Z]{3}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Currency"
          },
          "exception_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Exception Id"
          },
          "exception_priority": {
            "anyOf": [
              {
                "maximum": 3.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Exception Priority"
          },
          "exception_sla_due_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Exception Sla Due At"
          },
          "exception_type": {
            "anyOf": [
              {
                "maxLength": 128,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Exception Type"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "invoice_number": {
            "anyOf": [
              {
                "maxLength": 128,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Invoice Number"
          },
          "po_number": {
            "anyOf": [
              {
                "maxLength": 128,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Po Number"
          },
          "run_id": {
            "format": "uuid",
            "title": "Run Id",
            "type": "string"
          },
          "run_status": {
            "enum": [
              "QUEUED",
              "RUNNING",
              "PAUSED",
              "COMPLETED",
              "FAILED",
              "CANCELLED"
            ],
            "title": "Run Status",
            "type": "string"
          },
          "source": {
            "enum": [
              "UPLOAD",
              "EMAIL"
            ],
            "title": "Source",
            "type": "string"
          },
          "status": {
            "enum": [
              "RECEIVED",
              "QUEUED",
              "PROCESSING",
              "NEEDS_REVIEW",
              "APPROVED",
              "REJECTED",
              "RETURNED",
              "ARCHIVED",
              "FAILED"
            ],
            "title": "Status",
            "type": "string"
          },
          "total_amount": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Total Amount"
          },
          "vendor_name": {
            "anyOf": [
              {
                "maxLength": 256,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Vendor Name"
          }
        },
        "required": [
          "id",
          "run_id",
          "status",
          "run_status",
          "source",
          "content_type",
          "created_at"
        ],
        "title": "InvoiceSummary",
        "type": "object"
      },
      "InvoiceUploadResponse": {
        "additionalProperties": false,
        "properties": {
          "duplicate": {
            "default": false,
            "title": "Duplicate",
            "type": "boolean"
          },
          "invoice_id": {
            "format": "uuid",
            "title": "Invoice Id",
            "type": "string"
          },
          "run_id": {
            "format": "uuid",
            "title": "Run Id",
            "type": "string"
          },
          "status": {
            "const": "QUEUED",
            "default": "QUEUED",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "invoice_id",
          "run_id"
        ],
        "title": "InvoiceUploadResponse",
        "type": "object"
      },
      "JsonValue": {},
      "LivenessResponse": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "LivenessResponse",
        "type": "object"
      },
      "ProblemDetails": {
        "additionalProperties": false,
        "properties": {
          "dependencies": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DependencyStatuses"
              },
              {
                "type": "null"
              }
            ]
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "instance": {
            "title": "Instance",
            "type": "string"
          },
          "status": {
            "maximum": 599.0,
            "minimum": 400.0,
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "trace_id": {
            "pattern": "^[0-9a-f]{32}$",
            "title": "Trace Id",
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "title",
          "status",
          "detail",
          "instance",
          "trace_id"
        ],
        "title": "ProblemDetails",
        "type": "object"
      },
      "ReadinessResponse": {
        "additionalProperties": false,
        "properties": {
          "dependencies": {
            "$ref": "#/components/schemas/DependencyStatuses"
          },
          "status": {
            "const": "ready",
            "default": "ready",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "dependencies"
        ],
        "title": "ReadinessResponse",
        "type": "object"
      }
    },
    "securitySchemes": {
      "PersonaToken": {
        "scheme": "bearer",
        "type": "http"
      },
      "ServiceToken": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "InvoiceOps API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Healthz",
        "tags": [
          "health"
        ]
      }
    },
    "/readyz": {
      "get": {
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Required infrastructure is unavailable or unconfigured"
          }
        },
        "summary": "Readyz",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/exceptions/{exception_id}/decision": {
      "post": {
        "operationId": "submit_exception_decision_v1_exceptions__exception_id__decision_post",
        "parameters": [
          {
            "in": "path",
            "name": "exception_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Exception Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DecisionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DecisionResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "security": [
          {
            "PersonaToken": []
          }
        ],
        "summary": "Submit Exception Decision",
        "tags": [
          "exceptions"
        ]
      }
    },
    "/v1/invoices": {
      "get": {
        "operationId": "list_invoices_v1_invoices_get",
        "parameters": [
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "RECEIVED",
                    "QUEUED",
                    "PROCESSING",
                    "NEEDS_REVIEW",
                    "APPROVED",
                    "REJECTED",
                    "RETURNED",
                    "ARCHIVED",
                    "FAILED"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          },
          {
            "in": "query",
            "name": "run_status",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "QUEUED",
                    "RUNNING",
                    "PAUSED",
                    "COMPLETED",
                    "FAILED",
                    "CANCELLED"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Run Status"
            }
          },
          {
            "in": "query",
            "name": "source",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "UPLOAD",
                    "EMAIL"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Source"
            }
          },
          {
            "in": "query",
            "name": "exception_only",
            "required": false,
            "schema": {
              "default": false,
              "title": "Exception Only",
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "min_priority",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 3,
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Min Priority"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 200,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvoicePage"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Forbidden"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "security": [
          {
            "PersonaToken": []
          }
        ],
        "summary": "List Invoices",
        "tags": [
          "invoices"
        ]
      },
      "post": {
        "operationId": "upload_invoice_v1_invoices_post",
        "parameters": [
          {
            "description": "Stable replay key, validated before body reading.",
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "file": {
                    "format": "binary",
                    "type": "string"
                  }
                },
                "required": [
                  "file"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvoiceUploadResponse"
                }
              }
            },
            "description": "Existing content rejected as duplicate"
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvoiceUploadResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Unauthorized"
          },
          "408": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Request Timeout"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Conflict"
          },
          "413": {
            "content": {
              "application/json": {
