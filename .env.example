# Synthetic local-development credentials. Replace before any shared deployment.
POSTGRES_USER=invoiceops
POSTGRES_PASSWORD=invoiceops-local-only
POSTGRES_DB=invoiceops
INVOICEOPS_SEED=20260827
# The API uses the separate, restricted invoiceops_app role.
INVOICEOPS_APP_PASSWORD=invoiceops-app-local-only-password
# For URI-reserved characters, percent-encode credentials in the appropriate DSN.
# Keep INVOICEOPS_APP_PASSWORD as the raw password used to provision the role.
# Owner DSN is used only by the one-shot migrate service.
# INVOICEOPS_MIGRATION_DSN=postgresql+psycopg://invoiceops:encoded-owner-password@postgres:5432/invoiceops
# Runtime DSN is used only by the API; use the invoiceops_app role.
# INVOICEOPS_POSTGRES_DSN=postgresql://invoiceops_app:encoded-app-password@postgres:5432/invoiceops
# Graph demo bootstrap uses an owner-capable connection for its isolated langgraph schema.
# INVOICEOPS_CHECKPOINT_DSN=postgresql://invoiceops:encoded-password@postgres:5432/invoiceops
MINIO_ROOT_USER=invoiceops-local
MINIO_ROOT_PASSWORD=invoiceops-local-only-password
INVOICEOPS_RAW_BUCKET=invoiceops-raw
INVOICEOPS_SERVICE_TOKEN=invoiceops-local-upload-token
INVOICEOPS_WEBHOOK_SECRET=invoiceops-local-email-webhook-secret-2026
# Webhook timestamps are accepted within 300 seconds of API receipt.
# INVOICEOPS_WEBHOOK_WINDOW_SECONDS=300
# INVOICEOPS_WEBHOOK_MAX_BYTES=14680064
# INVOICEOPS_WEBHOOK_TIMEOUT_SECONDS=30
# Standalone API also needs INVOICEOPS_MINIO_ACCESS_KEY and INVOICEOPS_MINIO_SECRET_KEY.
# Optional API upload bounds: defaults are 10 MiB document, 11 MiB whole request, 30 seconds.
# INVOICEOPS_DOCUMENT_MAX_BYTES=10485760
# INVOICEOPS_UPLOAD_MAX_BYTES=11534336
# INVOICEOPS_UPLOAD_TIMEOUT_SECONDS=30
# INVOICEOPS_STORAGE_TIMEOUT_SECONDS=10
LITELLM_MASTER_KEY=replace-with-your-litellm-api-key
LITELLM_API_BASE=https://aigateway.adityaparab.info/v1

LITELLM_MODEL=gptoss120
LITELLM_EXTRACT_MODEL=gemini25flash
LITELLM_EMBED_MODEL=replace-with-your-384-dimension-embedding-model-name
# Set false to disable automatic approval even when the composite gate passes.
# INVOICEOPS_AUTO_APPROVAL_ENABLED=true

# Optional gateway profile: set only the selected upstream's variables.
LITELLM_CONFIG=config.yaml
# NATIVE_LITELLM_BASE_URL=http://host.docker.internal:4000/v1
# NATIVE_LITELLM_API_KEY=replace-with-your-native-gateway-key
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_EXTRACT_MODEL=ollama_chat/your-installed-vision-model
# OLLAMA_TRIAGE_MODEL=ollama_chat/your-installed-chat-model
# OLLAMA_JUDGE_MODEL=ollama_chat/your-installed-judge-model
# OLLAMA_EMBED_MODEL=ollama/your-installed-embedding-model
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=replace-with-your-provider-key

API_PORT=8000
POSTGRES_PORT=5432
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# Keep the optional Compose proxy separate from a native gateway on port 4000.
LITELLM_PORT=4001

# Application gateway client (step 1.5); no default provider endpoint or implicit key.
# Use the app-accessible LiteLLM URL and pin the deployed physical model/routing revision.
# INVOICEOPS_GATEWAY_BASE_URL=http://litellm:4000/v1
# INVOICEOPS_GATEWAY_API_KEY=replace-with-your-gateway-key
# INVOICEOPS_GATEWAY_ALIASES={"extract-vision":{"model_version":"replace-with-pinned-model-revision","allow_images":true}}
